# Modèle de référence : la commande « sudo numfranc --installer-serveur » écrit ce fichier toute seule
# dans /etc/systemd/system/ (voir SERVEUR.txt). Inutile de le copier à la main.
[Unit]
Description=NumFranc - noeud permanent (se relance tout seul)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=-/etc/default/numfranc-serveur
ExecStart=/usr/bin/numfranc --serveur --dossier /var/lib/numfranc $NUMFRANC_ARGS
Restart=always
RestartSec=10
WatchdogSec=180
TimeoutStartSec=300
Nice=10
DynamicUser=yes
StateDirectory=numfranc
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
